+++ b/src/mesh/UsbSfBridge.cpp
@@ -0,0 +1,78 @@
+#include "UsbSfBridge.h"
+#include <cstring>
+
+namespace {
+uint32_t read32(const uint8_t *p) {
+  return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) |
+         (uint32_t(p[3]) << 24);
+}
+} // namespace
+
+void UsbSfBridge::reset() {
+  session = token = 0;
+  lastSize = 0;
+  pending = false;
+}
+
+void UsbSfBridge::respond(const uint8_t *request, uint8_t status) {
+  memset(reply, 0, sizeof(reply));
+  memcpy(reply, request, 16);
+  reply[4] |= 0x80;
+  reply[5] = status;
+  reply[6] = reply[7] = 0;
+  // Profile 0 advertises diagnostics only; no replay path or radio queue
+  // exists.
+  reply[19] = 1;
+  reply[20] = 12;
+  memcpy(reply + 28, "54e0d8d0ab2ff56b3a9ce967e53f79e49af560fb", 40);
+  pending = true;
+}
+
+void UsbSfBridge::handle(const uint8_t *data, size_t size) {
+  if (pending || size < 16 || size > sizeof(lastRequest) ||
+      memcmp(data, "USF1", 4) || (data[4] & 0x80))
+    return;
+  uint32_t incomingSession = read32(data + 8);
+  uint32_t incomingToken = read32(data + 12);
+  if (!incomingSession || !incomingToken)
+    return;
+  if (data[5] || data[6] || data[7]) {
+    respond(data, 1);
+    return;
+  }
+  if (incomingSession == session && incomingToken == token) {
+    if (size == lastSize && !memcmp(data, lastRequest, size)) {
+      memcpy(reply, lastReply, sizeof(reply));
+      pending = true;
+    } else {
+      respond(data, 5);
+    }
+    return;
+  }
+  if (incomingSession == session && incomingToken < token) {
+    respond(data, 4);
+    return;
+  }
+  if (data[4] == 1 && size == 16) {
+    session = incomingSession;
+  } else if (incomingSession != session) {
+    respond(data, 3);
+    return;
+  }
+  uint8_t status = 2;
+  if (data[4] == 1 || data[4] == 3)
+    status = size == 16 ? 0 : 1;
+  else if (data[4] == 2)
+    status =
+        7; // Replay stays disabled until encrypted packet identity is resolved.
+  respond(data, status);
+  token = incomingToken;
+  lastSize = size;
+  memcpy(lastRequest, data, size);
+  memcpy(lastReply, reply, sizeof(reply));
+}
+
+void UsbSfBridge::takeReply(uint8_t *out) {
+  memcpy(out, reply, sizeof(reply));
+  pending = false;
+}
