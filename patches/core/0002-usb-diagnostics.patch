+++ b/src/mesh/UsbSfBridge.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+class UsbSfBridge {
+public:
+  static constexpr size_t RESPONSE_SIZE = 68;
+  void reset();
+  void handle(const uint8_t *data, size_t size);
+  bool available() const { return pending; }
+  void takeReply(uint8_t *out);
+
+private:
+  uint32_t session = 0;
+  uint32_t token = 0;
+  size_t lastSize = 0;
+  uint8_t lastRequest[256] = {};
+  uint8_t lastReply[RESPONSE_SIZE] = {};
+  uint8_t reply[RESPONSE_SIZE] = {};
+  bool pending = false;
+  void respond(const uint8_t *request, uint8_t status);
+};
