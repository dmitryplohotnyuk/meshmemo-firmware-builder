+// Keep the serial power state active while allowing the display to time out.
+static uint32_t serialScreenOnAt;
+static bool serialScreenBlanked;
+
 static void serialEnter()
 {
     LOG_POWERFSM("State: serialEnter");
+    serialScreenOnAt = millis();
+    serialScreenBlanked = false;
     setBluetoothEnable(false);
     if (screen) {
         screen->setOn(true);
+    }
+}
+
+static void serialIdle()
+{
+    // Never enter DARK here: the serial state also prevents CPU sleep and keeps
+    // USB servicing active. API heartbeats must not restart the display timer.
+    if (!screen || serialScreenBlanked || config.display.screen_on_secs == UINT32_MAX)
+        return;
+#ifdef USE_EINK
+    if (config.display.screen_on_secs == 0)
+        return;
+#endif
+    const uint32_t timeout = Default::getConfiguredOrDefaultMs(config.display.screen_on_secs, default_screen_on_secs);
+    if (static_cast<uint32_t>(millis() - serialScreenOnAt) >= timeout) {
+        screen->setOn(false);
+        serialScreenBlanked = true; // Queue the display command only once per wake.
     }
 }
 
